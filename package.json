{
  "name": "filepeek",
  "version": "1.0.0",
  "description": "FilePeek – Know Everything About Your Files. Premium Windows File Information & Inspector Application.",
  "main": "app/main.js",
  "author": "Omkar Patil",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/patilomkar7570/filepeek.git"
  },
  "bugs": {
    "url": "https://github.com/patilomkar7570/filepeek/issues"
  },
  "homepage": "https://github.com/patilomkar7570/filepeek#readme",
  "keywords": [
    "filepeek",
    "file-inspector",
    "metadata-extractor",
    "magic-bytes",
    "shannon-entropy",
    "hash-calculator",
    "sha256",
    "md5",
    "privacy-first",
    "windows-utility",
    "electron"
  ],
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win",
    "package:portable": "electron-builder --win portable",
    "package:dir": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.filepeek.app",
    "productName": "FilePeek",
    "copyright": "Copyright © 2026 Omkar Patil",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FilePeek",
      "artifactName": "FilePeek-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "FilePeek-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
